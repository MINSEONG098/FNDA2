/**
 * [센트럴점] 냉장 간편식 프로모션 사전 고객 설문조사 Google Form 자동 생성 Apps Script
 * 
 * 기획안: 「골라 담는 한 끼, 함께 사면 500원 할인」 프로모션 사전 검증
 * 대상 점포: 센트럴점
 * 
 * [Google Apps Script 사용 방법]
 * 1. Google Drive (https://drive.google.com)에 로그인합니다.
 * 2. 좌측 상단 [+ 새로 만들기] > [더보기] > [Google Apps Script] 클릭
 *    (또는 브라우저 주소창에 script.new 입력)
 * 3. 코드 편집기에 아래 스크립트 내용을 전체 복사하여 붙여넣습니다.
 * 4. 상단 함수 선택 드롭다운에서 'createCentralPromotionSurvey' 선택 후 [▶ 실행] 클릭
 * 5. 최초 1회 [권한 검토] 창이 뜨면 계정 선택 > [고급] > [제목 없는 프로젝트(으)로 이동] > [허용] 클릭
 * 6. 실행 완료 후 하단 [실행 로그]에 출력되는 '설문지 편집 URL' 및 '고객 응답용 URL'을 확인합니다.
 */

function createCentralPromotionSurvey() {
  // 1. 구글 폼 생성 및 기본 메타데이터 설정
  const formTitle = '[센트럴점] 냉장 간편식 프로모션 사전 고객 설문조사';
  const form = FormApp.create(formTitle);

  // 2. 설문지 안내 설명문 설정
  form.setDescription(
    '안녕하세요. 센트럴점을 이용해 주시는 고객님께 진심으로 감사드립니다.\n\n' +
    '저희 매장에서는 고객님께 더욱 실속 있고 균형 잡힌 식사 혜택을 제공해 드리고자\n' +
    '「골라 담는 한 끼, 함께 사면 500원 할인」 프로모션을 준비하고 있습니다.\n\n' +
    '본 프로모션 진행에 앞서 고객님의 소중한 식사 패턴과 의견을 반영하고자 하오니,\n' +
    '잠시만 시간을 내어 설문에 참여해 주시면 대단히 감사하겠습니다. (소요 시간: 약 1~2분)\n\n' +
    '※ 응답해 주신 내용은 신규 프로모션 기획 및 매장 개선을 위한 통계 자료로만 활용됩니다.'
  );

  form.setConfirmationMessage('설문에 참여해 주셔서 대단히 감사합니다. 고객님의 의견을 적극 반영하여 더욱 만족스러운 혜택으로 찾아뵙겠습니다.');
  form.setAllowResponseEdits(false);
  form.setAcceptingResponses(true);

  // =========================================================================
  // [문항 1] 식사 목적 및 이용 상황 (타깃 고객 적합성 검증)
  // =========================================================================
  const q1 = form.addMultipleChoiceItem();
  q1.setTitle('1. 고객님께서 센트럴점에서 냉장 간편식(도시락, 덮밥, 샐러드랩 등)을 구매하실 때 주로 어떤 목적으로 이용하십니까?')
    .setHelpText('가장 주된 구매 목적 1가지를 선택해 주세요.')
    .setChoiceValues([
      '혼자 빠르게 해결하는 점심/저녁 식사 (1인 한 끼)',
      '동료·가족과 함께 나눠 먹는 식사 (2인 이상)',
      '식사 외 가벼운 간식이나 야식',
      '메인 식사에 곁들이는 보조 메뉴(사이드)'
    ])
    .showOtherOption(true)
    .setRequired(true);

  // =========================================================================
  // [문항 2] 묶음 구매 수요 (핵심 가설 검증: 샐러드랩 + 밥류 동시 구매 의향)
  // =========================================================================
  const q2 = form.addMultipleChoiceItem();
  q2.setTitle("2. 간편식을 선택하실 때, 가벼운 '샐러드랩'과 든든한 '덮밥/볶음밥류'를 함께(동시에) 구매하여 드실 의향이 있으십니까?")
    .setHelpText('예: 훈제오리 샐러드랩 + 소불고기덮밥 조합')
    .setChoiceValues([
      '매우 그렇다 (한 끼 식사로 양과 영양 균형이 맞아 함께 먹기 좋다)',
      '2인이 함께 먹거나 혜택(할인)이 있다면 같이 살 의향이 있다',
      '보통이다',
      '그렇지 않다 (한 끼로 먹기엔 양이나 가격이 부담스럽다)',
      '전혀 그렇지 않다 (둘 중 단품 하나만 먹는 것을 선호한다)'
    ])
    .setRequired(true);

  // =========================================================================
  // [문항 3] 대상 상품 이탈/감소 원인 파악 (문제 진단)
  // =========================================================================
  const q3 = form.addMultipleChoiceItem();
  q3.setTitle('3. 최근 센트럴점의 샐러드랩이나 간편 덮밥류를 구매하지 않으셨거나 구매 횟수를 줄이셨다면, 가장 큰 이유는 무엇입니까?')
    .setHelpText('가장 큰 원인 1가지를 선택해 주세요.')
    .setChoiceValues([
      '단품 가격 대비 가성비 부담',
      '메뉴의 다양성이나 맛/품질 만족도 부족',
      '다른 간편식(삼각김밥, 샌드위치, 컵라면 등) 대체 구매',
      '매대 위치나 진열이 눈에 잘 띄지 않아서',
      '평소 해당 메뉴를 꾸준히 구매하며 줄이지 않았다'
    ])
    .showOtherOption(true)
    .setRequired(true);

  // =========================================================================
  // [문항 4] 프로모션 혜택 매력도 및 가격 체감도 (손익 및 수요 검증)
  // =========================================================================
  const q4 = form.addMultipleChoiceItem();
  q4.setTitle("4. [훈제오리 샐러드랩 + 소불고기덮밥 또는 닭갈비볶음밥] 세트 구매 시 '500원 즉시 할인' 혜택이 제공된다면 구매하시겠습니까?")
    .setHelpText('정상 합계 약 11,700~12,100원 → 프로모션 행사가 11,200~11,600원 (약 4.1~4.3% 할인)')
    .setChoiceValues([
      '매우 매력적이며, 출시되면 반드시 구매해 볼 것이다',
      '구성이 마음에 들어 구매할 의향이 있다',
      '보통이다 (메뉴 조합이나 당일 상황에 따라 고민할 것 같다)',
      '할인 금액(500원)이 적어 구매 유인이 되지 않는다',
      '세트 구성 자체를 구매할 생각이 없다'
    ])
    .setRequired(true);

  // =========================================================================
  // [문항 5] 매장 내 홍보물 노출 경로 (한정된 예산 6만 원 최적 집행 검증)
  // =========================================================================
  const q5 = form.addMultipleChoiceItem();
  q5.setTitle('5. 매장 내에서 이러한 할인 프로모션 소식을 접하신다면, 구매를 결정하는 데 가장 눈에 잘 띄는 안내 위치는 어디입니까?')
    .setHelpText('매장 방문 시 프로모션 정보를 가장 인지하기 쉬운 위치를 선택해 주세요.')
    .setChoiceValues([
      '냉장 간편식 매대 앞 부착 배너 / 스티커',
      '점포 출입구 및 쇼핑바구니 거치대 안내물',
      '해당 상품 진열 가격표(네임택) 바로 옆',
      '계산대(POS) 앞 안내판'
    ])
    .showOtherOption(true)
    .setRequired(true);

  // 3. 생성 결과 및 링크 출력
  Logger.log('================================================================');
  Logger.log('🎉 [센트럴점] 사전 설문조사 Google Form이 성공적으로 생성되었습니다!');
  Logger.log('================================================================');
  Logger.log('📝 설문지 편집/관리 URL : ' + form.getEditUrl());
  Logger.log('🔗 고객 배포용(응답) URL : ' + form.getPublishedUrl());
  Logger.log('================================================================');
}
